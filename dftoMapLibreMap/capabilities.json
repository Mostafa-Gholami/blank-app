{
  "dataRoles": [
    {
      "name": "station",
      "kind": "Grouping",
      "displayName": "Station",
      "description": "Station name or CRS. One row per station; used as the cross-filter key."
    },
    {
      "name": "latitude",
      "kind": "GroupingOrMeasure",
      "displayName": "Latitude",
      "description": "WGS84 latitude (decimal degrees)."
    },
    {
      "name": "longitude",
      "kind": "GroupingOrMeasure",
      "displayName": "Longitude",
      "description": "WGS84 longitude (decimal degrees)."
    },
    {
      "name": "facilityOwner",
      "kind": "Grouping",
      "displayName": "Station Facility Owner (colour)",
      "description": "Colours station bubbles and drives the legend."
    },
    {
      "name": "constituency",
      "kind": "Grouping",
      "displayName": "Constituency",
      "description": "Constituency name. Values must match the GeoJSON name property (PCON24NM) so clicking a polygon filters the report."
    },
    {
      "name": "mainline",
      "kind": "Grouping",
      "displayName": "Mainline",
      "description": "The station's Mainline column (a line name, or Yes/No). Used to style mainline vs non-mainline stations. If it holds line names that match the rail GeoJSON, clicking a line filters the report to that line."
    },
    {
      "name": "details",
      "kind": "Grouping",
      "displayName": "Tooltip details",
      "description": "Text attributes shown in the station tooltip (e.g. CRS, MP_Name, Mainline, District, County)."
    },
    {
      "name": "inRadius",
      "kind": "Measure",
      "displayName": "In radius flag",
      "description": "e.g. [In_Radius]. Stations where this is 0/blank/false are hidden (toggle in Stations card)."
    },
    {
      "name": "radiusLat",
      "kind": "Measure",
      "displayName": "Radius centre latitude",
      "description": "e.g. [Sel_Lat]. Draws the radial-search circle."
    },
    {
      "name": "radiusLon",
      "kind": "Measure",
      "displayName": "Radius centre longitude",
      "description": "e.g. [Sel_Lon]."
    },
    {
      "name": "radiusMiles",
      "kind": "Measure",
      "displayName": "Radius (miles)",
      "description": "e.g. [Radius_mi Value]."
    },
    {
      "name": "tooltips",
      "kind": "Measure",
      "displayName": "Tooltip measures",
      "description": "Extra measures for the tooltip, e.g. a CONCATENATEX of serving operators."
    }
  ],
  "dataViewMappings": [
    {
      "conditions": [
        {
          "station": {
            "max": 1
          },
          "latitude": {
            "max": 1
          },
          "longitude": {
            "max": 1
          },
          "facilityOwner": {
            "max": 1
          },
          "constituency": {
            "max": 1
          },
          "inRadius": {
            "max": 1
          },
          "radiusLat": {
            "max": 1
          },
          "radiusLon": {
            "max": 1
          },
          "radiusMiles": {
            "max": 1
          },
          "mainline": {
            "max": 1
          }
        }
      ],
      "categorical": {
        "categories": {
          "select": [
            {
              "bind": {
                "to": "station"
              }
            },
            {
              "bind": {
                "to": "latitude"
              }
            },
            {
              "bind": {
                "to": "longitude"
              }
            },
            {
              "bind": {
                "to": "facilityOwner"
              }
            },
            {
              "bind": {
                "to": "constituency"
              }
            },
            {
              "bind": {
                "to": "mainline"
              }
            },
            {
              "bind": {
                "to": "details"
              }
            }
          ],
          "dataReductionAlgorithm": {
            "top": {
              "count": 30000
            }
          }
        },
        "values": {
          "select": [
            {
              "bind": {
                "to": "latitude"
              }
            },
            {
              "bind": {
                "to": "longitude"
              }
            },
            {
              "bind": {
                "to": "inRadius"
              }
            },
            {
              "bind": {
                "to": "radiusLat"
              }
            },
            {
              "bind": {
                "to": "radiusLon"
              }
            },
            {
              "bind": {
                "to": "radiusMiles"
              }
            },
            {
              "bind": {
                "to": "tooltips"
              }
            }
          ]
        }
      }
    }
  ],
